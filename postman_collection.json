{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Multi-Tenant Data Source Routing API",
    "description": "Postman Collection for testing header-based multi-tenant data source routing, tenant data isolation, error scenarios, and Spring Boot Actuator health endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "tenant1",
      "value": "tenant1",
      "type": "string"
    },
    {
      "key": "tenant2",
      "value": "tenant2",
      "type": "string"
    },
    {
      "key": "tenant3",
      "value": "tenant3",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Actuator & Health",
      "item": [
        {
          "name": "GET Tenant Data Sources Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All tenant data sources are UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.components).to.have.property(\"tenant1\");",
                  "    pm.expect(jsonData.components.tenant1.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.components).to.have.property(\"tenant2\");",
                  "    pm.expect(jsonData.components.tenant2.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.components).to.have.property(\"tenant3\");",
                  "    pm.expect(jsonData.components.tenant3.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/datasources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "datasources"
              ]
            },
            "description": "Fetches the composite health status of all configured multi-tenant data sources."
          },
          "response": []
        },
        {
          "name": "GET General Application Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Overall system status is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Fetches standard Spring Boot actuator overall health."
          },
          "response": []
        }
      ],
      "description": "Spring Boot Actuator composite health and database monitoring endpoints."
    },
    {
      "name": "Tenant 1 Operations",
      "item": [
        {
          "name": "POST Create User - Tenant 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"User created with valid ID and attributes\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.name).to.eql(\"Alice Smith\");",
                  "    pm.expect(jsonData.email).to.eql(\"alice@tenant1.com\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@tenant1.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Creates a new user record routed strictly to Tenant 1 database."
          },
          "response": []
        },
        {
          "name": "GET List Users - Tenant 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns array of users for Tenant 1\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Retrieves all user records stored in Tenant 1 database."
          },
          "response": []
        },
        {
          "name": "GET User by ID - Tenant 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns Tenant 1 user payload\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "    pm.expect(jsonData.name).to.eql(\"Alice Smith\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "1"
              ]
            },
            "description": "Fetches single user by ID from Tenant 1 database."
          },
          "response": []
        }
      ],
      "description": "Requests targeted specifically to Tenant 1."
    },
