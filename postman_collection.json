    {
      "name": "Error Handling & Interceptors",
      "item": [
        {
          "name": "GET Missing X-Tenant-ID Header (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns missing header error response payload\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"Bad Request\");",
                  "    pm.expect(jsonData.message).to.eql(\"X-Tenant-ID header is missing\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Verifies that requests missing the required X-Tenant-ID header return 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "GET Unknown Tenant (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Returns tenant not found error response payload\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"Not Found\");",
                  "    pm.expect(jsonData.message).to.eql(\"Tenant not found: unknown_tenant\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "unknown_tenant",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Verifies that requests with an unregistered tenant ID return 404 Not Found."
          },
          "response": []
        }
      ],
      "description": "Error condition requests to validate interceptor security and header enforcement."
